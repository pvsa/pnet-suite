#! /bin/bash                                                                                                                                                                                                                       
## PvSA 3.3.25 find latest zabbix log file and open if with less                                                                                                                                                                               
### PvSA 15.8.26 change conecpt to tail and limit log lines and change path

ZBXLOG="$(find /var/log/zabbix/ -type f -name *.log |grep zabbix)"
#echo $ZBXLOG                                                                                                                                                                                                                       
if [[ -z $ZBXLOG ]]; then
        echo "no zabbix log file found"                                                                                                                                                                                            
        #that was used in the last 59 min"                                                                                                                                                                                         
 else
    tail -f -n 25 $ZBXLOG
fi
         
