#! /bin/bash
## find latest zabbix log file and open if with less
## PvSA 3.3.25

DMIN="-360"

ZBXLOG="$(find /var/log/ -mmin $DMIN -type f |grep zabbix |head -1)"
#echo $ZBXLOG

if [[ -z $ZBXLOG ]]; then
        echo "no zabbix log file found that was used in the last 59 min"
 else
    less +F $ZBXLOG
fi             
